<style>
  @keyframes flow-active {
    to {
      stroke-dashoffset: -20;
    }
  }
  @keyframes flow-standby {
    to {
      stroke-dashoffset: -40;
    }
  }
  .active-path {
    stroke-dasharray: 6, 4;
    animation: flow-active 0.8s linear infinite;
  }
  .standby-path {
    stroke-dasharray: 4, 8;
    animation: flow-standby 4s linear infinite;
  }
  .glow-active-node {
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.15), inset 0 0 15px rgba(16, 185, 129, 0.05);
  }
  .glow-ingress-node {
    box-shadow: 0 0 20px rgba(99, 102, 241, 0.1), inset 0 0 10px rgba(99, 102, 241, 0.05);
  }
  
  /* Guarantee solid backgrounds on dotted container */
  .bg-solid-900 {
    background-color: #0f172a !important;
  }
  .bg-solid-950 {
    background-color: #020617 !important;
  }
  .border-solid-800 {
    border-color: #1e293b !important;
  }
</style>

<!-- Create App Modal -->
<section id="create-modal" style="display:<%= @create_modal_display %>">
  <div class="fixed z-50 inset-0 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <!-- Overlay background -->
      <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm transition-opacity" aria-hidden="true" phx-click="hide-modal"></div>

      <!-- Centering trick -->
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

      <!-- Modal panel -->
      <div class="inline-block align-bottom bg-solid-900 border border-solid-800 rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full">
        <div class="bg-solid-900 px-6 pt-6 pb-4">
          <div class="flex items-center space-x-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
              📥
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-100" id="modal-title">Track New Application</h3>
              <p class="text-[11px] text-slate-500 font-mono">Connect deployed K8s replicas to Watcher</p>
            </div>
          </div>
          <form phx-submit="create-app" class="space-y-4">
            <div>
              <label class="block text-[10px] font-mono font-bold text-indigo-400 uppercase tracking-wider mb-2">Application Name</label>
              <input type="text" 
                     class="w-full bg-solid-950 border border-solid-800 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl py-2 px-4 text-sm text-slate-100 placeholder-slate-600 font-mono focus:outline-none transition-colors" 
                     name="app-name" 
                     value="<%= @query %>" 
                     placeholder="e.g., wsgo-price" 
                     required 
                     autocomplete="off"
                     autofocus>
            </div>
            <div class="flex items-center justify-end space-x-3 pt-2">
              <button type="button" 
                      phx-click="hide-modal" 
                      class="px-4 py-2 border border-solid-800 hover:border-slate-700 bg-solid-950 text-slate-400 hover:text-slate-200 font-mono text-xs rounded-xl transition-colors">
                Cancel
              </button>
              <button type="submit" 
                      class="px-4 py-2 bg-indigo-500 hover:bg-indigo-600 text-slate-950 font-bold font-mono text-xs rounded-xl shadow-lg shadow-indigo-500/10 transition-all duration-200 hover:-translate-y-0.5">
                Register
              </button>
            </div>
          </form>
        </div>
        <p class="text-xs text-pink-500 bg-pink-500/5 border-t border-pink-500/10 py-3 px-6 font-mono text-center" style="display:<%= @create_app_warning %>">
          ⚠️ Application ID already registered in the registry database.
        </p>
      </div>
    </div>
  </div>
</section>

<div class="max-w-7xl mx-auto px-6 py-8">

  <%= if @selected_app !== nil do %>
    <!-- App Details / Inspector View -->
    <div class="flex flex-col space-y-6">
      
      <!-- Back Header -->
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <button type="button" 
                  phx-click="back" 
                  class="p-2 border border-solid-800 hover:border-slate-700 bg-solid-900 text-slate-400 hover:text-slate-100 rounded-xl transition-all duration-200 hover:-translate-x-0.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <div>
            <div class="flex items-center space-x-2">
              <h2 class="text-xl font-bold text-slate-100 font-mono"><%= @selected_app %></h2>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-mono font-bold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
                Tracked App
              </span>
            </div>
            <p class="text-[10px] text-slate-500 font-mono">Registry Route Allocation Inspector</p>
          </div>
        </div>

        <div class="flex items-center space-x-3">
          <button type="button" 
                  phx-click="delete-app" 
                  phx-value-app="<%= @selected_app %>"
                  data-confirm="Are you sure you want to stop tracking this application? Existing K8s pods will remain running but will no longer be monitored."
                  class="px-4 py-2 border border-pink-500/20 hover:border-pink-500/40 bg-pink-500/5 hover:bg-pink-500/10 text-pink-400 font-mono text-xs rounded-xl shadow-lg transition-all duration-200">
            Delete Application
          </button>
        </div>
      </div>

      <!-- App Meta Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="flex flex-col bg-solid-900 border border-solid-800 p-5 rounded-2xl shadow-xl">
          <span class="text-[10px] font-mono font-bold text-indigo-400 uppercase tracking-wider mb-1">Active Replicas</span>
          <span class="text-2xl font-black text-slate-100 font-mono"><%= @selected_app_details |> Enum.count %></span>
          <p class="text-[10px] text-slate-500 font-mono mt-1">Healthy pods detected in cluster namespace</p>
        </div>
        <div class="flex flex-col col-span-2 bg-solid-900 border border-solid-800 p-5 rounded-2xl shadow-xl justify-between">
          <div>
            <span class="text-[10px] font-mono font-bold text-indigo-400 uppercase tracking-wider mb-1">Client Allocation Endpoint</span>
            <div class="flex items-center justify-between bg-solid-950 border border-solid-800 px-4 py-1.5 rounded-xl font-mono text-xs text-slate-300 mt-1 select-all hover:text-slate-200 transition-colors">
              <span><%= Application.get_env(:discovery, :base_url) %>/api/endpoint?app_name=<%= @selected_app %></span>
              <span class="text-[10px] text-slate-600 uppercase font-bold">GET</span>
            </div>
          </div>
          <p class="text-[10px] text-slate-500 font-mono mt-2">Game clients query this endpoint to resolve the active server routing URL</p>
        </div>
      </div>

      <!-- Deployment Graph -->
      <div class="flex flex-col space-y-4">
        <h3 class="text-xs font-mono font-bold text-indigo-400 uppercase tracking-wider">Topology Graph</h3>

        <div class="relative flex flex-col lg:flex-row items-stretch justify-between p-8 bg-solid-900 backdrop-blur-md rounded-3xl border border-solid-800 gap-12 overflow-hidden min-h-[360px] shadow-2xl">
          
          <!-- Decorative subtle grid background pattern -->
          <div class="absolute inset-0 opacity-[0.02] pointer-events-none" style="background-image: radial-gradient(circle, #6366f1 1px, transparent 1px); background-size: 20px 20px;"></div>

          <!-- Left Column: Ingress Gateway -->
          <div class="flex flex-col items-center justify-center lg:w-1/3 min-w-[220px] z-10">
            <div class="relative flex flex-col items-center p-6 bg-solid-950 border border-indigo-500/40 rounded-2xl w-full text-center glow-ingress-node">
              <!-- Decorative border glow -->
              <div class="absolute -inset-0.5 bg-gradient-to-r from-indigo-500/20 to-purple-500/20 rounded-2xl blur opacity-30"></div>
              
              <div class="relative flex flex-col items-center w-full">
                <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 text-xl mb-3 shadow-inner">
                  ⚡
                </div>
                <span class="font-mono font-bold text-slate-200 text-xs tracking-wider uppercase">Ingress Gateway</span>
                <span class="text-[10px] text-indigo-400 font-mono mt-1 truncate w-full" title="<%= @selected_app %>.example.com"><%= @selected_app %>.example.com</span>
                
                <div class="mt-4 pt-3 border-t border-solid-800 w-full text-[9px] font-mono text-slate-500 space-y-1">
                  <div class="flex justify-between"><span>Provider:</span><span class="text-indigo-400 font-medium">Nginx Ingress</span></div>
                  <div class="flex justify-between"><span>Namespace:</span><span class="text-indigo-400 font-medium">discovery</span></div>
                  <div class="flex justify-between"><span>Traffic:</span><span class="text-emerald-400 font-medium animate-pulse">Monitoring</span></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Middle Column: Dynamic SVG Connectors (Desktop Only) -->
          <% 
            pods_count = Enum.count(@selected_app_details)
          %>
          <div class="hidden lg:block w-36 flex-shrink-0 relative">
            <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 100 100">
              <%= for {deployment, idx} <- Enum.with_index(@selected_app_details) do %>
                <% 
                  target_y = if pods_count <= 1, do: 50, else: 15 + (70 * idx) / (pods_count - 1)
                  active? = deployment["active"]
                %>
                <!-- Curved Bezier Connection Line -->
                <path d="M 0 50 C 45 50, 55 <%= target_y %>, 100 <%= target_y %>" 
                      fill="none" 
                      stroke="<%= if active?, do: "#10b981", else: "#334155" %>" 
                      stroke-width="<%= if active?, do: "2.5", else: "1.5" %>" 
                      class="<%= if active?, do: "active-path", else: "standby-path" %>" />
              <% end %>
            </svg>
          </div>

          <!-- Right Column: Pods List (Targets) -->
          <div class="flex flex-col gap-4 flex-grow lg:max-w-xl z-10 w-full justify-center">
            <%= if @selected_app_details == [] do %>
              <div class="flex flex-col items-center justify-center p-8 bg-solid-950 border border-dashed border-solid-800 rounded-2xl text-center">
                <div class="text-2xl mb-2">🔍</div>
                <p class="text-xs font-mono text-slate-500">No active pods detected in Kubernetes cluster</p>
                <p class="text-[10px] text-slate-600 font-mono mt-1">Make sure you have running pods labeled with "app: <%= @selected_app %>"</p>
              </div>
            <% end %>

            <%= for deployment <- @selected_app_details do %>
              <% active? = deployment["active"] %>
              <div class="group relative flex flex-col p-5 bg-solid-900 border rounded-2xl shadow-xl transition-all duration-300 hover:scale-[1.01] hover:bg-slate-900/90 <%= if active?, do: "border-emerald-500/50 glow-active-node", else: "border-solid-800 hover:border-slate-700" %>">
                
                <!-- Status tag -->
                <div class="absolute top-4 right-4 flex items-center space-x-1.5 px-2 py-0.5 rounded-full <%= if active?, do: "bg-emerald-500/10 border border-emerald-500/20 text-emerald-400", else: "bg-slate-800/80 border border-slate-700 text-slate-400" %>">
                  <%= if active? do %>
                    <span class="relative flex h-1.5 w-1.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                    </span>
                    <span class="text-[8px] font-mono font-bold uppercase tracking-wider">Active Route</span>
                  <% else %>
                    <span class="w-1.5 h-1.5 bg-slate-500 rounded-full"></span>
                    <span class="text-[8px] font-mono font-bold uppercase tracking-wider">Draining / Standby</span>
                  <% end %>
                </div>

                <!-- Header / Title -->
                <div class="flex items-center space-x-3 mb-3">
                  <div class="w-9 h-9 rounded-xl <%= if active?, do: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20", else: "bg-slate-800 text-slate-400 border-slate-700" %> border flex items-center justify-center text-sm shadow-inner">
                    📦
                  </div>
                  <div>
                    <h4 class="font-mono font-bold text-slate-200 text-xs truncate max-w-[200px]" title="<%= deployment["name"] %>">
                      <%= deployment["name"] %>
                    </h4>
                    <p class="text-[9px] text-slate-500 font-mono">Resource Version: <%= deployment["version"] %></p>
                  </div>
                </div>

                 <!-- Info Grid -->
                 <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-[10px] font-mono text-slate-400 py-3 border-t border-solid-800 mb-3">
                   <div class="flex justify-between border-b border-solid-800/50 pb-1">
                     <span class="text-slate-600">IP:</span>
                     <span class="text-slate-300"><%= deployment["ip"] %></span>
                   </div>
                   <div class="flex justify-between border-b border-solid-800/50 pb-1">
                     <span class="text-slate-600">Port:</span>
                     <span class="text-slate-300"><%= deployment["port"] %></span>
                   </div>
                   <div class="flex justify-between border-b border-solid-800/50 pb-1">
                     <span class="text-slate-600">Namespace:</span>
                     <span class="text-slate-300"><%= Map.get(deployment, "namespace", "unknown") %></span>
                   </div>
                   <div class="flex justify-between border-b border-solid-800/50 pb-1">
                     <!-- Spacer col -->
                     <span></span>
                     <span></span>
                   </div>
                   <div class="flex justify-between col-span-2">
                     <span class="text-slate-600">Image:</span>
                     <span class="text-slate-300 truncate w-40 text-right cursor-help" title="<%= deployment["image"] %>">
                       <%= String.split(deployment["image"], "/") |> List.last() %>
                     </span>
                   </div>
                 </div>

                <!-- Dynamic route details / test button -->
                <div class="flex items-center justify-between gap-3 pt-1">
                  <div class="flex-grow px-3 py-1.5 bg-solid-950 border border-solid-800 rounded-lg text-[9px] font-mono text-slate-400 select-all overflow-hidden truncate">
                    <%= deployment["url"] %>
                  </div>
                  <%= if active? do %>
                    <a href="http://<%= deployment["url"] %>/ping" target="_blank" class="flex-shrink-0 px-3 py-1.5 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold font-mono rounded-lg text-[9px] shadow-lg shadow-emerald-500/10 transition-all duration-200 hover:-translate-y-0.5">
                      Test Endpoint
                    </a>
                  <% else %>
                    <div class="flex-shrink-0 px-3 py-1.5 bg-slate-900 border border-slate-800 text-slate-500 font-bold font-mono rounded-lg text-[9px] text-center select-none cursor-not-allowed">
                      Draining
                    </div>
                  <% end %>
                </div>

              </div>
            <% end %>
          </div>

        </div>
      </div>

    </div>
  <% else %>
    <!-- Dashboard Landing View -->
    <div class="flex flex-col space-y-8">
      
      <!-- Stats Summary Banner -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="flex items-center justify-between p-6 bg-solid-900 border border-solid-800 rounded-2xl shadow-xl">
          <div>
            <p class="text-[10px] font-mono font-bold text-indigo-400 uppercase tracking-wider mb-0.5">Total Tracked Apps</p>
            <p class="text-2xl font-black text-slate-100 font-mono"><%= @apps |> Enum.count %></p>
          </div>
          <div class="text-2xl p-2 bg-indigo-500/10 border border-indigo-500/20 rounded-xl">📁</div>
        </div>
        
        <div class="flex items-center justify-between p-6 bg-solid-900 border border-solid-800 rounded-2xl shadow-xl">
          <div>
            <p class="text-[10px] font-mono font-bold text-indigo-400 uppercase tracking-wider mb-0.5">Active Pod Replicas</p>
            <p class="text-2xl font-black text-slate-100 font-mono">
              <%= @apps |> Enum.reduce(0, fn app, acc -> acc + app.deployments end) %>
            </p>
          </div>
          <div class="text-2xl p-2 bg-emerald-500/10 border border-emerald-500/20 rounded-xl">📦</div>
        </div>

        <div class="flex items-center justify-between p-6 bg-solid-900 border border-solid-800 rounded-2xl shadow-xl">
          <div>
            <p class="text-[10px] font-mono font-bold text-indigo-400 uppercase tracking-wider mb-0.5">Kubernetes Watcher</p>
            <span class="inline-flex items-center mt-1 text-emerald-400 text-xs font-mono font-bold">
              <span class="w-1.5 h-1.5 mr-1.5 bg-emerald-400 rounded-full animate-ping"></span>
              Streaming Live
            </span>
          </div>
          <div class="text-2xl p-2 bg-pink-500/10 border border-pink-500/20 rounded-xl">⚡</div>
        </div>
      </div>

      <!-- K8s Connection Guide Panel -->
      <div class="border border-solid-800 p-6 rounded-3xl relative overflow-hidden bg-solid-900/95 shadow-xl">
        <!-- Decorative bg glow -->
        <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-indigo-500/5 blur-3xl pointer-events-none"></div>

        <div class="relative flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="space-y-2 max-w-xl">
            <h3 class="text-slate-100 font-bold text-sm">💡 How to Connect Your Applications</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Discovery syncs container endpoints natively from Kubernetes. Simply register your application key name here, apply the tracking label in your deployment YAML, and query our microsecond endpoint allocator from your client.
            </p>
          </div>
          
          <button phx-click="show-create-modal" 
                  type="button" 
                  class="px-5 py-2.5 bg-indigo-500 hover:bg-indigo-600 text-slate-950 font-bold font-mono text-xs rounded-xl shadow-lg shadow-indigo-500/15 transition-all duration-200 hover:-translate-y-0.5 flex items-center gap-2">
            <span>+</span> Track Application
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6 pt-6 border-t border-solid-800 text-[10px] font-mono text-slate-500">
          <div class="space-y-1">
            <span class="text-indigo-400 font-bold">1. REGISTER APP KEY</span>
            <p>Create the application domain inside Discovery to initialize event stream monitoring.</p>
          </div>
          <div class="space-y-1">
            <span class="text-indigo-400 font-bold">2. LABEL K8S MANIFEST</span>
            <p>Add label <code class="text-slate-400 bg-solid-950 px-1 py-0.5 rounded border border-solid-800">app: &lt;app_name&gt;</code> under target namespace <code class="text-slate-400 bg-solid-950 px-1 py-0.5 rounded border border-solid-800">discovery</code>.</p>
          </div>
          <div class="space-y-1">
            <span class="text-indigo-400 font-bold">3. ROUTE ALLOCATION API</span>
            <p>Query client route: <code class="text-slate-400 bg-solid-950 px-1 py-0.5 rounded border border-solid-800">GET /api/endpoint?app_name=...</code> to fetch active pod suffix.</p>
          </div>
        </div>
      </div>

      <!-- Application Directory List -->
      <div class="flex flex-col space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-mono font-bold text-indigo-400 uppercase tracking-wider">Application Directory</h3>
        </div>

        <div class="bg-solid-900 border border-solid-800 rounded-2xl overflow-hidden shadow-2xl">
          <%= if @apps == [] do %>
            <div class="flex flex-col items-center justify-center p-12 text-center bg-solid-950/40">
              <div class="text-3xl mb-3">📁</div>
              <h4 class="text-slate-200 text-xs font-mono font-bold">No Tracked Applications Found</h4>
              <p class="text-[10px] text-slate-500 font-mono mt-1">Register a new app domain above to start monitoring Kubernetes pod endpoints.</p>
            </div>
          <% else %>
            <div class="divide-y divide-slate-800/60 font-mono">
              <!-- Table Header -->
              <div class="grid grid-cols-4 px-6 py-3 bg-solid-950 text-[9px] font-bold text-indigo-400 uppercase tracking-wider text-left border-b border-solid-800">
                <div>App Key</div>
                <div class="text-center">Active Pods</div>
                <div>Allocation Endpoint</div>
                <div class="text-right">Status</div>
              </div>

              <!-- Table Rows -->
              <%= for app <- @apps do %>
                <div phx-click="select-app" 
                     phx-value-app="<%= app.app_name %>"
                     class="grid grid-cols-4 px-6 py-4 items-center text-xs text-slate-300 hover:bg-slate-800 hover:text-slate-100 cursor-pointer border-b border-solid-800/40 transition-all duration-150">
                  <div class="font-bold text-slate-200"><%= app.app_name %></div>
                  <div class="text-center">
                    <span class="px-2 py-0.5 bg-solid-950 border border-solid-800 rounded-md font-bold">
                      <%= app.deployments %>
                    </span>
                  </div>
                  <div class="text-[11px] text-slate-400 truncate pr-4" title="<%= app.url %>"><%= app.url %></div>
                  <div class="flex justify-end">
                    <%= if app.deployments === 0 do %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-slate-800 text-slate-400 border border-slate-700/50">
                        empty
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        <span class="w-1.5 h-1.5 mr-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
                        healthy
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  <% end %>

</div>
